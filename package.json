{
  "name": "ledger-lens",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted financial investigation workspace — turn a pile of financial exports into an explainable, queryable, alert-driven picture of what actually happened to your money.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && pnpm arch:grep",
    "arch:grep": "bash scripts/arch-grep.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:contract": "vitest run --config vitest.contract.config.ts --passWithNoTests",
    "test:engine": "vitest run src/server/engine --passWithNoTests",
    "e2e": "playwright test",
    "eval": "vitest run evals --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "analyze": "ANALYZE=true next build",
    "size": "node scripts/size-check.mjs",
    "explain:baseline": "node scripts/explain-baseline.mjs",
    "verify:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.0",
    "fast-check": "^4.9.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.33.0"
}
