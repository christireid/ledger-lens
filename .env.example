# Ledger Lens environment — full matrix in spec §23.4; typed module in src/server/env.ts (§07.9).
# Copy to .env.local for local development. Secrets never in the repo.

# --- Database (Supabase) ---
# Pooled connection (transaction mode, port 6543) for the app
DATABASE_URL=
# Session-mode connection: migrations, integration tests
DIRECT_URL=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Svix signature verification for the Clerk webhook
CLERK_WEBHOOK_SECRET=

# --- OpenAI (AI gateway, §07.8) ---
# Set to MOCK to run AI features against the mocked gateway (§22)
OPENAI_API_KEY=MOCK

# --- Upstash Redis (rate limiting; optional until M5 — fail-open per §07.7) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron route header auth ---
CRON_SECRET=

# --- App ---
# Absolute URL construction
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo-mode workspace binding (§15.7)
DEMO_WORKSPACE_ID=
# Preview-only test-session endpoint (§20.8); MUST be unset in prod
DEMO_E2E_SECRET=

# --- Observability (§24) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional log drain; unset = Vercel logs only
AXIOM_TOKEN=

# --- Nightly-only real-API smoke flag (§22.5) ---
OPENAI_SMOKE=
